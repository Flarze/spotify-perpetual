# Copy to .env and fill in. Never commit .env.
#
# Prefer a single config file? Copy config.example.yaml to config.yaml instead;
# it is auto-loaded from next to this .env and can hold everything below.

# Spotify app credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Playlist(s) to keep alive when idle. One, or several separated by commas.
# Accepts spotify:playlist:... URIs or open.spotify.com links.
#   PLAYLISTS=spotify:playlist:aaaa,spotify:playlist:bbbb
PLAYLISTS=

# Polling interval in seconds
POLL_INTERVAL=30

# Path for the OAuth token cache (this file is a SECRET)
TOKEN_CACHE_PATH=.cache

# Treat a paused-but-loaded session as "listening"? (true = don't restart)
PAUSED_COUNTS_AS_PLAYING=true

# When acting on a paused track (PAUSED_COUNTS_AS_PLAYING=false), resume that
# same track instead of starting a fresh playlist. (default false)
RESUME_PAUSED_TRACK=false

# Wait this many seconds before auto-resuming a pause; if you resume or change
# the track yourself within the window, it is left alone. (default 0 = instant)
RESUME_DELAY_SECONDS=0

# Status backend: api (Web API; needs Premium token) or hybrid (read playback
# from local Windows SMTC, no API status polling; control still uses the API).
MODE=api

# How often (seconds) the tray re-reads SMTC to refresh the track in hybrid mode.
LISTENER_POLL_SECONDS=1.0

# Set volume (0-100) on start/resume; leave blank to keep the device's volume.
VOLUME=
# Ramp volume up over this many seconds on start/resume (0 = off).
FADE_IN_SECONDS=0
